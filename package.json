{
  "name": "echo-run",
  "version": "1.4.0",
  "description": "A Phaser survival game where your past movement paths become enemies.",
  "author": "Tharindu Hettige (https://github.com/TharinduNava)",
  "license": "MIT",
  "main": "electron/main.js",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TharinduNava/Echo-Run.git"
  },
  "bugs": {
    "url": "https://github.com/TharinduNava/Echo-Run/issues"
  },
  "homepage": "https://github.com/TharinduNava/Echo-Run#readme",
  "keywords": [
    "game",
    "phaser",
    "javascript",
    "vite",
    "survival",
    "arcade"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "build": {
    "appId": "com.echorun.game",
    "productName": "Echo Run",
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release/"
    },
    "mac": {
      "target": "dmg",
      "identity": null
    },
    "linux": {
      "target": "AppImage"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "icon": "build/icon.png"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "electron:start": "vite build && electron .",
    "electron:build": "vite build && electron-builder"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "phaser": "^4.2.1"
  }
}
